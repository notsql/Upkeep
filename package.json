{
  "name": "proj",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:generate": "nx run-many -t openapi --projects=server && nx run-many -t openapi:types --projects=@proj/api",
    "build": "nx run-many -t build",
    "check": "nx run-many -t lint",
    "check-types": "nx run-many -t check-types",
    "db:deploy": "nx run @proj/db:db:migrate:deploy",
    "db:generate": "nx run-many -t db:generate --projects=@proj/db,server",
    "db:migrate": "nx run @proj/db:db:migrate",
    "db:reset": "nx run-many -t db:reset --projects=@proj/db",
    "db:studio": "nx run-many -t db:studio --projects=@proj/db",
    "dev": "nx run-many -t dev",
    "dev:server": "nx run-many -t dev --projects=server",
    "dev:web": "nx run-many -t dev --projects=web",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "fix": "nx run-many -t lint:fix",
    "test": "nx run-many -t test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@nx/maven": "23.2.1",
    "@proj/config": "workspace:*",
    "@types/node": "catalog:",
    "nx": "^23.2.1",
    "typescript": "catalog:",
    "ultracite": "7.12.2"
  },
  "packageManager": "pnpm@12.8.1"
}

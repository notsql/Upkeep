  "components": {
    "schemas": {
      "EstateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 200, "minLength": 0 },
          "code": { "type": "string", "maxLength": 50, "minLength": 0 },
          "address": { "type": "string", "maxLength": 500, "minLength": 0 },
          "postalCode": { "type": "string", "maxLength": 20, "minLength": 0 },
          "description": { "type": "string", "maxLength": 2000, "minLength": 0 }
        },
        "required": ["address", "code", "name", "postalCode"]
      },
      "EstateError": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"]
      },
      "EstateResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "code": { "type": "string" },
          "address": { "type": "string" },
          "postalCode": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deactivatedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": [
          "address",
          "code",
          "createdAt",
          "id",
          "name",
          "postalCode",
          "updatedAt"
        ]
      },
      "DeactivateEstateRequest": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "maxLength": 50, "minLength": 0 }
        },
        "required": ["code"]
      },
      "CreateLocationRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["BLOCK", "LEVEL", "COMMON_AREA"]
          },
          "parentId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 200, "minLength": 0 },
          "sortOrder": { "type": "integer", "format": "int32" }
        },
        "required": ["name", "type"]
      },
      "LocationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": {
            "type": "string",
            "enum": ["BLOCK", "LEVEL", "COMMON_AREA"]
          },
          "parentId": { "type": ["string", "null"], "format": "uuid" },
          "name": { "type": "string" },
          "sortOrder": {
            "type": ["integer", "null"],
            "format": "int32",
            "description": "A level's position in its block, lowest first"
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deactivatedAt": { "type": ["string", "null"], "format": "date-time" }
        },
        "required": ["createdAt", "id", "name", "type", "updatedAt"]
      },
      "UpdateLocationRequest": {
        "type": "object",
        "properties": {
          "parentId": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "maxLength": 200, "minLength": 0 },
          "sortOrder": { "type": "integer", "format": "int32" }
        },
        "required": ["name"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "database": { "type": "boolean" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["database", "ok", "timestamp"]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}

  "components": {
    "schemas": {
      "EstateError": {
        "type": "object",
        "properties": { "message": { "type": "string" } },
        "required": ["message"]
      },
      "UserRoles": {
        "type": "object",
        "properties": {
          "roleSlugs": { "type": "array", "items": { "type": "string" } }
        }
      },
      "EstateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "maxLength": 200, "minLength": 0 },
          "code": { "type": "string", "maxLength": 50, "minLength": 0 },
          "address": { "type": "string", "maxLength": 500, "minLength": 0 },
          "postalCode": { "type": "string", "maxLength": 20, "minLength": 0 },
          "description": { "type": "string", "maxLength": 2000, "minLength": 0 }
        },
        "required": ["address", "code", "name", "postalCode"]
      },
      "EstateResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "code": { "type": "string" },
          "address": { "type": "string" },
          "postalCode": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "deactivatedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "owned": { "type": "boolean" }
        },
        "required": [
          "address",
          "code",
          "createdAt",
          "id",
          "name",
          "owned",
          "postalCode",
          "updatedAt"
        ]
      },
      "DeactivateEstateRequest": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "maxLength": 50, "minLength": 0 }
        },
        "required": ["code"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "database": { "type": "boolean" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["database", "ok", "timestamp"]
      },
      "EstateAccessResponse": {
        "type": "object",
        "properties": {
          "estateId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "code": { "type": "string" },
          "active": { "type": "boolean" },
          "owner": { "type": "boolean" },
          "granted": { "type": "boolean" }
        },
        "required": ["active", "code", "estateId", "granted", "name", "owner"]
      },
      "Role": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      },
      "AdminUserResponse": {
        "type": "object",
        "properties": {
          "membershipId": { "type": "string" },
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "joined": { "type": "string" },
          "roleSlugs": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}

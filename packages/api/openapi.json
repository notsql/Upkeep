    "/api/admin/users/{userId}/estates": {
      "get": {
        "tags": ["estate-access-controller"],
        "summary": "List every estate with a user's access",
        "operationId": "listUserEstateAccess",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EstateAccessResponse"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Admin role required",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EstateAccessResponse"
                  }
                }
              }
            }
          },
          "404": {

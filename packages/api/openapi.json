          },
          "409": {
            "description": "Duplicate estate code",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "200": {
            "description": "Your estates",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/EstateResponse" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["estate-controller"],
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/EstateRequest" }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "401": {
            "description": "Sign in required",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "404": {
            "description": "Estate not found",
            "content": {
              "*/*": {

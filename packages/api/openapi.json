{
  "openapi": "3.1.0",
  "info": { "title": "proj API", "version": "v1" },
  "servers": [
    { "url": "http://localhost:8080", "description": "Generated server url" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/api/admin/users/{userId}/estates/{estateId}": {
      "put": {
        "tags": ["estate-access-controller"],
        "summary": "Grant a user access to an estate",
        "operationId": "grantEstateAccess",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "estateId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "401": { "description": "Sign in required" },
          "403": { "description": "Admin role required" },
          "404": {
            "description": "Estate not found",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "204": { "description": "Access granted" }
        }
      },
      "delete": {
        "tags": ["estate-access-controller"],
        "summary": "Revoke a user's access to an estate",
        "operationId": "revokeEstateAccess",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "estateId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "401": { "description": "Sign in required" },
          "403": { "description": "Admin role required" },
          "404": {
            "description": "Estate not found",
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/EstateError" }
              }
            }
          },
          "204": { "description": "Access revoked" }
        }
      }
    },

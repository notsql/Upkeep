generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Estate {
  id            String             @id @default(uuid()) @db.Uuid
  ownerUserId   String             @db.VarChar(255)
  name          String             @db.VarChar(200)
  code          String             @unique @db.VarChar(50)
  address       String             @db.VarChar(500)
  postalCode    String             @db.VarChar(20)
  description   String?            @db.VarChar(2000)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime?          @db.Timestamptz(6)
  locations     Location[]
  users         EstateUser[]
  assets        Asset[]
  devices       Device[]
  assessments   AssetAssessment[]
  invitations   EstateInvitation[]
  issueReports  IssueReport[]
  events        AssetEvent[]
  flatlinePolicies FlatlinePolicy[]
  workOrders    WorkOrder[]

  roleDefinitions EstateRoleDefinition[]

  @@index([ownerUserId])
}

// A block, level or common area inside an estate. Levels sit under blocks;
// common areas sit under a block or a level. `parentType` repeats the parent's
// type, and the composite foreign key also carries `estateId`, so Postgres
// rejects a parent of the wrong type or from another estate. The type rules
// themselves live in the hand-written Location_hierarchy_check constraint in
// the migration (Prisma cannot express CHECK constraints). Rows are never
// deleted: deactivation keeps the ID stable for records that reference it.
model Location {
  id            String    @id @default(uuid()) @db.Uuid
  estateId      String    @db.Uuid
  type          String    @db.VarChar(20)
  parentId      String?   @db.Uuid
  parentType    String?   @db.VarChar(20)
  name          String    @db.VarChar(200)
  sortOrder     Int?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent       Location?     @relation("LocationTree", fields: [parentId, parentType, estateId], references: [id, type, estateId], onDelete: Restrict, onUpdate: Restrict)
  children     Location[]    @relation("LocationTree")
  assets       Asset[]
  devices      Device[]
  issueReports IssueReport[]
  workOrders   WorkOrder[]

  @@unique([id, type, estateId])
  @@unique([id, estateId])
  @@index([estateId])
  @@index([parentId])
}

// A WorkOS user an admin has assigned to an estate, giving them view access.
// Ownership stays on Estate.ownerUserId; see decision 0012.
model EstateUser {
  customRoleId     String? @db.Uuid
  customRole EstateRoleDefinition? @relation(fields: [customRoleId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  role             String   @default("MEMBER") @db.VarChar(20)
  canInviteMembers Boolean  @default(false)
  estateId         String   @db.Uuid
  userId           String   @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, userId])
  @@index([userId])
}

model IssueReport {
  id                String   @id @default(uuid()) @db.Uuid
  submittedByUserId String   @db.VarChar(255)
  estateId          String   @db.Uuid
  locationId        String   @db.Uuid
  title             String   @db.VarChar(150)
  description       String   @db.VarChar(2500)
  status            String   @default("SUBMITTED") @db.VarChar(20)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  estate   Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location Location           @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  images   IssueReportImage[]
  workOrders WorkOrder[]

  @@unique([id, estateId])
  @@index([submittedByUserId, createdAt, id])
  @@index([estateId])
  @@index([estateId, createdAt, id])
  @@index([estateId, locationId, createdAt, id])
}

model IssueReportImage {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @db.Uuid
  storageKey  String   @unique @db.VarChar(500)
  contentType String   @db.VarChar(50)
  sizeBytes   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  report IssueReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reportId])
}

// A piece of equipment in an estate. `reference` is assigned by the server as
// `<ESTATE CODE>-A<nnnn>` (decision 0015). The composite foreign key to Location
// carries `estateId`, so Postgres rejects a location from another estate. Rows
// are never deleted: deactivation sets `deactivatedAt`.
model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  estateId       String    @db.Uuid
  locationId     String    @db.Uuid
  reference      String    @db.VarChar(60)
  name           String    @db.VarChar(200)
  category       String    @db.VarChar(30)
  installedOn    DateTime? @db.Date
  manufacturerId String?   @db.Uuid
  modelId        String?   @db.Uuid
  serialNumber   String?   @db.VarChar(200)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt  DateTime? @db.Timestamptz(6)

  retiredOn        DateTime?             @db.Date
  retirementReason String?               @db.VarChar(2000)
  lifecycleVersion Int                   @default(0)
  lifecycleEvents  AssetLifecycleEvent[]

  estate        Estate            @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location      Location          @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  assetCategory AssetCategory     @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)
  manufacturer  Manufacturer?     @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model         AssetModel?       @relation(fields: [modelId, manufacturerId, category], references: [id, manufacturerId, category], onDelete: Restrict, onUpdate: Restrict)
  devices       Device[]
  readings      DeviceReading[]
  flatlinePauses DeviceFlatlinePause[]
  assessments   AssetAssessment[]
  events        AssetEvent[]
  workOrders    WorkOrder[]

  @@unique([id, estateId])
  @@unique([estateId, reference])
  @@index([estateId])
  @@index([locationId])
  @@index([modelId])
}

// An open job in an estate (decision 0032). Equipment links are optional;
// several jobs may reference one resident report. References never change.
model WorkOrder {
  id                    String   @id @default(uuid()) @db.Uuid
  estateId              String   @db.Uuid
  reference             String   @db.VarChar(70)
  description           String   @db.VarChar(2500)
  locationId            String   @db.Uuid
  assetId               String?  @db.Uuid
  category              String   @db.VarChar(30)
  priority              String   @db.VarChar(30)
  source                String   @db.VarChar(30)
  sourceReportId        String?  @db.Uuid
  sourceReference       String?  @db.VarChar(500)
  status                String   @default("OPEN") @db.VarChar(20)
  createdByUserId        String   @db.VarChar(255)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @db.Timestamptz(6)

  estate       Estate      @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location     Location    @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset        Asset?      @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  sourceReport IssueReport? @relation(fields: [sourceReportId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([estateId, reference])
  @@index([estateId, createdAt, id])
}

// An asset category (decision 0026). `code` is stable and is what assets and
// catalogue models store. Rows are added only by migrations.
model AssetCategory {
  code   String       @id @db.VarChar(30)
  label  String       @db.VarChar(100)
  assets Asset[]
  models AssetModel[]
}

// A manufacturer, shared by all estates (decision 0026). `name` is stored
// normalised: trimmed, inner whitespace collapsed, uppercased. Rows never change.
model Manufacturer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(200)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  models    AssetModel[]
  assets    Asset[]
  events    AssetEvent[]
}

// A model of one manufacturer in one asset category, shared by all estates
// (decision 0026). `name` is normalised like Manufacturer.name. The extra
// uniques are targets of the composite foreign keys on Asset and AssetEvent.
model AssetModel {
  id             String   @id @default(uuid()) @db.Uuid
  manufacturerId String   @db.Uuid
  category       String   @db.VarChar(30)
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  manufacturer  Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetCategory AssetCategory @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)
  assets        Asset[]
  events        AssetEvent[]

  @@unique([manufacturerId, category, name])
  @@unique([id, manufacturerId])
  @@unique([id, manufacturerId, category])
}

// Something that happened to an asset on a date. Append-only like
// AssetAssessment: no updatedAt. `manufacturerId` and `modelId` snapshot the
// asset's catalogue entries when recorded (decision 0026).
model AssetEvent {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @db.Uuid
  assetId          String   @db.Uuid
  type             String   @db.VarChar(30)
  occurredOn       DateTime @db.Date
  notes            String   @db.VarChar(2000)
  manufacturerId   String?  @db.Uuid
  modelId          String?  @db.Uuid
  recordedByUserId String   @db.VarChar(255)
  recordedByName   String?  @db.VarChar(200)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset        Asset         @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model        AssetModel?   @relation(fields: [modelId, manufacturerId], references: [id, manufacturerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId])
  @@index([assetId, occurredOn, createdAt])
}

// A sensor or meter registered against an asset (decision 0016). `identifier`
// is the label the manager enters, unique across all estates; it is not a
// credential. `metrics` holds names from the server's fixed catalogue. The
// composite foreign keys carry `estateId`, so Postgres rejects a device whose
// asset or location belongs to another estate.
model Device {
  id                       String    @id @default(uuid()) @db.Uuid
  estateId                 String    @db.Uuid
  assetId                  String    @db.Uuid
  locationId               String    @db.Uuid
  identifier               String    @unique @db.VarChar(100)
  model                    String    @db.VarChar(200)
  metrics                  String[]  @db.VarChar(30)
  reportingIntervalSeconds Int
  lastSeenAt               DateTime? @db.Timestamptz(6)
  // SHA-256 hex of the device's API key; the key itself is never stored (decision 0025).
  credentialHash           String?   @unique @db.Char(64)
  credentialIssuedAt       DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  estate   Estate          @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset    Asset           @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  location Location        @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  readings DeviceReading[]
  flatlinePauses DeviceFlatlinePause[]

  @@unique([id, estateId])
  @@index([estateId])
  @@index([assetId])
  @@index([locationId])
}

// One measurement a device submitted (ID-43). Append-only: no updatedAt. A
// reading is identified by device, metric and `measuredAt` (decision 0028), so
// a retry cannot store it twice. `assetId` is the device's asset when the
// reading arrived. There is no unit column: the metric fixes it (decision 0016).
// The composite foreign keys carry `estateId`, so Postgres rejects a reading
// whose device or asset belongs to another estate.
model DeviceReading {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  estateId   String   @db.Uuid
  assetId    String   @db.Uuid
  metric     String   @db.VarChar(30)
  value      Decimal  @db.Decimal(18, 6)
  measuredAt DateTime @db.Timestamptz(6)
  receivedAt DateTime @db.Timestamptz(6)

  device Device @relation(fields: [deviceId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deviceId, metric, measuredAt])
  @@index([assetId, metric, measuredAt])
}

// Shared detection settings for a metric within one estate (ID-68).
// No row means not configured; duration bounds and decimal validation live in the API.
model FlatlinePolicy {
  estateId        String   @db.Uuid
  metric          String   @db.VarChar(30)
  durationMinutes Int
  tolerance       Decimal  @default(0) @db.Decimal(18, 6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, metric])
}

// Retain the latest pause after expiry: resumesAt remains the fresh-start cutoff.
model DeviceFlatlinePause {
  deviceId       String   @db.Uuid
  metric         String   @db.VarChar(30)
  estateId       String   @db.Uuid
  assetId        String   @db.Uuid
  pausedAt       DateTime @db.Timestamptz(6)
  resumesAt      DateTime @db.Timestamptz(6)
  pausedByUserId String   @db.VarChar(255)

  device Device @relation(fields: [deviceId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@id([deviceId, metric])
  @@index([estateId])
}

// One condition assessment of an asset (decision 0017). Append-only: rows are
// never updated or deleted, so there is no updatedAt. The current condition is
// the latest `assessedOn`, then the latest `createdAt`. `recordedByName` is a
// WorkOS name snapshot taken when the row was written; null if WorkOS was
// unavailable. The composite foreign key keeps the estate consistent.
model AssetAssessment {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @db.Uuid
  assetId          String   @db.Uuid
  condition        String   @db.VarChar(30)
  assessedOn       DateTime @db.Date
  notes            String   @db.VarChar(2000)
  recordedByUserId String   @db.VarChar(255)
  recordedByName   String?  @db.VarChar(200)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId])
  @@index([assetId, assessedOn, createdAt])
}

model AssetLifecycleEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  estateId                 String    @db.Uuid
  assetId                  String    @db.Uuid
  action                   String    @db.VarChar(20)
  occurredAt               DateTime  @default(now()) @db.Timestamptz(6)
  actorUserId              String    @db.VarChar(255)
  previousDeactivatedAt    DateTime? @db.Timestamptz(6)
  previousRetiredOn        DateTime? @db.Date
  previousRetirementReason String?   @db.VarChar(2000)
  deactivatedAt            DateTime? @db.Timestamptz(6)
  retiredOn                DateTime? @db.Date
  retirementReason         String?   @db.VarChar(2000)
  lifecycleVersion         Int
  asset                    Asset     @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assetId, lifecycleVersion])
  @@index([estateId, assetId])
}

// Estate-local Council invitations; WorkOS owns identity and email delivery.
model EstateInvitation {
  customRoleId String? @db.Uuid
  customRole EstateRoleDefinition? @relation(fields: [customRoleId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  id                   String    @id @default(uuid()) @db.Uuid
  role                 String    @default("COUNCIL") @db.VarChar(20)
  estateId             String    @db.Uuid
  name                 String    @db.VarChar(200)
  email                String    @db.VarChar(254)
  inviterUserId        String    @db.VarChar(255)
  providerInvitationId String?   @unique @db.VarChar(255)
  status               String    @default("SENDING") @db.VarChar(20)
  createdAt            DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime? @db.Timestamptz(6)
  acceptedAt           DateTime? @db.Timestamptz(6)
  acceptedUserId       String?   @db.VarChar(255)
  estate               Estate    @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([estateId, email])
  @@index([email, status])
}

// Application-defined catalogue. Codes and enforcement change together through migrations.
model Permission {
  code String @id @db.VarChar(64)
  label String @db.VarChar(120)
  description String @db.VarChar(500)
  roles EstateRolePermission[]
}

model EstateRoleDefinition {
  id String @id @default(uuid()) @db.Uuid
  estateId String @db.Uuid
  name String @db.VarChar(40)
  normalizedName String @db.VarChar(40)
  description String? @db.VarChar(500)
  createdByUserId String @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  version Int @default(1)
  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions EstateRolePermission[]
  members EstateUser[]
  invitations EstateInvitation[]

  @@unique([id, estateId])
  @@unique([estateId, normalizedName])
}

model EstateRolePermission {
  roleId String @db.Uuid
  permission String @db.VarChar(64)
  role EstateRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  catalogue Permission @relation(fields: [permission], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permission])
}

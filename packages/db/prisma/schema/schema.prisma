generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Estate {
  id                   String                        @id @default(uuid()) @db.Uuid
  ownerUserId          String                        @db.VarChar(255)
  name                 String                        @db.VarChar(200)
  code                 String                        @unique @db.VarChar(50)
  address              String                        @db.VarChar(500)
  postalCode           String                        @db.VarChar(20)
  description          String?                       @db.VarChar(2000)
  createdAt            DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                      @updatedAt @db.Timestamptz(6)
  deactivatedAt        DateTime?                     @db.Timestamptz(6)
  locations            Location[]
  users                EstateUser[]
  assets               Asset[]
  devices              Device[]
  assessments          AssetAssessment[]
  invitations          EstateInvitation[]
  issueReports         IssueReport[]
  documents            Document[]
  events               AssetEvent[]
  flatlinePolicies     FlatlinePolicy[]
  workOrders           WorkOrder[]
  inspectionResults    AssetInspectionResult[]
  categoryFlags        AssetCategoryFlagChange[]
  categoryIntervals    AssetCategoryIntervalChange[]
  inspectionChecks     InspectionCheck[]
  inspectionRuns       InspectionListRun[]
  notifications        Notification[]
  notificationSettings EstateNotificationSettings?
  notificationSweeps   NotificationSweep[]

  roleDefinitions EstateRoleDefinition[]

  @@index([ownerUserId])
}

model Document {
  id                              String    @id @default(uuid()) @db.Uuid
  estateId                        String    @db.Uuid
  documentType                    String    @db.VarChar(20)
  originalFilename                String    @db.VarChar(255)
  contentType                     String    @db.VarChar(50)
  sizeBytes                       Int
  storageKey                      String    @unique @db.VarChar(500)
  uploadedByUserId                String    @db.VarChar(255)
  createdAt                       DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt                       DateTime? @db.Timestamptz(6)
  deletedByUserId                 String?   @db.VarChar(255)
  storageDeletedAt                DateTime? @db.Timestamptz(6)
  workOrderId                     String?   @db.Uuid
  workOrderAssociationVersion     Int       @default(0)
  assetId                         String?   @db.Uuid
  assetAssociationVersion         Int       @default(0)
  assetAssociationChangedByUserId String?   @db.VarChar(255)
  assetAssociationChangedAt       DateTime? @db.Timestamptz(6)

  estate          Estate                   @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workOrder       WorkOrder?               @relation(fields: [workOrderId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset           Asset?                   @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  workOrderEvents DocumentWorkOrderEvent[]

  @@unique([id, estateId])
  @@index([estateId, workOrderId, createdAt, id])
  @@index([estateId, assetId, createdAt, id])
  @@index([estateId, createdAt, id])
  @@index([deletedAt, storageDeletedAt])
}

// Association audit is independent of work-order completion/cost records.
model DocumentWorkOrderEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  documentId         String   @db.Uuid
  estateId           String   @db.Uuid
  fromWorkOrderId    String?  @db.Uuid
  toWorkOrderId      String?  @db.Uuid
  associationVersion Int
  correctionReason   String?  @db.VarChar(500)
  changedByUserId    String   @db.VarChar(255)
  changedByName      String?  @db.VarChar(255)
  changedAt          DateTime @default(now()) @db.Timestamptz(6)

  document      Document   @relation(fields: [documentId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  fromWorkOrder WorkOrder? @relation("DocumentLinkFrom", fields: [fromWorkOrderId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  toWorkOrder   WorkOrder? @relation("DocumentLinkTo", fields: [toWorkOrderId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([documentId, associationVersion])
  @@index([estateId, documentId, associationVersion])
}

// A block, level or common area inside an estate. Levels sit under blocks;
// common areas sit under a block or a level. `parentType` repeats the parent's
// type, and the composite foreign key also carries `estateId`, so Postgres
// rejects a parent of the wrong type or from another estate. The type rules
// themselves live in the hand-written Location_hierarchy_check constraint in
// the migration (Prisma cannot express CHECK constraints). Rows are never
// deleted: deactivation keeps the ID stable for records that reference it.
model Location {
  id            String    @id @default(uuid()) @db.Uuid
  estateId      String    @db.Uuid
  type          String    @db.VarChar(20)
  parentId      String?   @db.Uuid
  parentType    String?   @db.VarChar(20)
  name          String    @db.VarChar(200)
  sortOrder     Int?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  estate            Estate                  @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent            Location?               @relation("LocationTree", fields: [parentId, parentType, estateId], references: [id, type, estateId], onDelete: Restrict, onUpdate: Restrict)
  children          Location[]              @relation("LocationTree")
  assets            Asset[]
  devices           Device[]
  issueReports      IssueReport[]
  workOrders        WorkOrder[]
  inspectionResults AssetInspectionResult[]

  @@unique([id, type, estateId])
  @@unique([id, estateId])
  @@index([estateId])
  @@index([parentId])
}

// A WorkOS user an admin has assigned to an estate, giving them view access.
// Ownership stays on Estate.ownerUserId; see decision 0012.
model EstateUser {
  customRoleId     String?               @db.Uuid
  customRole       EstateRoleDefinition? @relation(fields: [customRoleId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  role             String                @default("MEMBER") @db.VarChar(20)
  canInviteMembers Boolean               @default(false)
  estateId         String                @db.Uuid
  userId           String                @db.VarChar(255)
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, userId])
  @@index([userId])
}

model IssueReport {
  id                String   @id @default(uuid()) @db.Uuid
  submittedByUserId String   @db.VarChar(255)
  estateId          String   @db.Uuid
  locationId        String   @db.Uuid
  title             String   @db.VarChar(150)
  description       String   @db.VarChar(2500)
  status            String   @default("SUBMITTED") @db.VarChar(20)
  urgency           String   @default("MEDIUM") @db.VarChar(20)
  isSafety          Boolean  @default(false)
  urgencyVersion    Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  estate      Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location    Location               @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  images      IssueReportImage[]
  workOrders  WorkOrder[]
  urgencyEvents IssueReportUrgencyEvent[]
  duplicateOf IssueReportDuplicate?  @relation("DuplicateReport")
  duplicates  IssueReportDuplicate[] @relation("DuplicateOriginal")

  @@unique([id, estateId])
  @@index([submittedByUserId, createdAt, id])
  @@index([estateId])
  @@index([estateId, createdAt, id])
  @@index([estateId, locationId, createdAt, id])
}

// A link from a fault report to the original it repeats (ID-74, spec
// fault-report-duplicates.md). One row per linked report; detection saves
// SUSPECTED links, managers confirm, reject or link by hand. Originals never
// hold a SUSPECTED/CONFIRMED link themselves, so chains cannot form. The
// self-link CHECK is hand-written in the migration.
model IssueReportDuplicate {
  reportId         String    @id @db.Uuid
  estateId         String    @db.Uuid
  originalReportId String    @db.Uuid
  state            String    @db.VarChar(20)
  source           String    @db.VarChar(20)
  locationMatch    String?   @db.VarChar(10)
  textSimilarity   Decimal?  @db.Decimal(4, 3)
  repeatCue        Boolean?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  decidedByUserId  String?   @db.VarChar(255)
  decidedAt        DateTime? @db.Timestamptz(6)

  report   IssueReport @relation("DuplicateReport", fields: [reportId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  original IssueReport @relation("DuplicateOriginal", fields: [originalReportId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportId, estateId])
  @@index([estateId, originalReportId, state])
}

model IssueReportUrgencyEvent {
  id              String   @id @default(uuid()) @db.Uuid
  estateId        String   @db.Uuid
  reportId        String   @db.Uuid
  version         Int
  fromUrgency     String   @db.VarChar(20)
  toUrgency       String   @db.VarChar(20)
  fromIsSafety    Boolean
  toIsSafety      Boolean
  changedByUserId String   @db.VarChar(255)
  changedByName   String?  @db.VarChar(255)
  changedAt       DateTime @default(now()) @db.Timestamptz(6)

  report IssueReport @relation(fields: [reportId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([reportId, version])
}

model IssueReportImage {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @db.Uuid
  storageKey  String   @unique @db.VarChar(500)
  contentType String   @db.VarChar(50)
  sizeBytes   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  report IssueReport @relation(fields: [reportId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([reportId])
}

// A piece of equipment in an estate. `reference` is assigned by the server as
// `<ESTATE CODE>-A<nnnn>` (decision 0015). The composite foreign key to Location
// carries `estateId`, so Postgres rejects a location from another estate. Rows
// are never deleted: deactivation sets `deactivatedAt`.
model Asset {
  id             String    @id @default(uuid()) @db.Uuid
  estateId       String    @db.Uuid
  locationId     String    @db.Uuid
  reference      String    @db.VarChar(60)
  name           String    @db.VarChar(200)
  category       String    @db.VarChar(30)
  installedOn    DateTime? @db.Date
  manufacturerId String?   @db.Uuid
  modelId        String?   @db.Uuid
  serialNumber   String?   @db.VarChar(200)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt  DateTime? @db.Timestamptz(6)

  retiredOn        DateTime?             @db.Date
  retirementReason String?               @db.VarChar(2000)
  lifecycleVersion Int                   @default(0)
  lifecycleEvents  AssetLifecycleEvent[]

  estate            Estate                  @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location          Location                @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  assetCategory     AssetCategory           @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)
  manufacturer      Manufacturer?           @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model             AssetModel?             @relation(fields: [modelId, manufacturerId, category], references: [id, manufacturerId, category], onDelete: Restrict, onUpdate: Restrict)
  devices           Device[]
  readings          DeviceReading[]
  manualReadings    ManualReading[]
  flatlinePauses    DeviceFlatlinePause[]
  assessments       AssetAssessment[]
  events            AssetEvent[]
  workOrders        WorkOrder[]
  inspectionResults AssetInspectionResult[]
  intervalChanges   AssetIntervalChange[]
  inspectionChecks  InspectionCheck[]
  anomalyScores     AnomalyScore[]
  notifications     Notification[]

  documents Document[]

  @@unique([id, estateId])
  @@unique([estateId, reference])
  @@index([estateId])
  @@index([locationId])
  @@index([modelId])
}

// A job in an estate (decisions 0032 and 0034). Equipment links are optional;
// several jobs may reference one resident report. References never change.
model WorkOrder {
  id                 String   @id @default(uuid()) @db.Uuid
  estateId           String   @db.Uuid
  reference          String   @db.VarChar(70)
  description        String   @db.VarChar(2500)
  locationId         String   @db.Uuid
  assetId            String?  @db.Uuid
  category           String   @db.VarChar(30)
  priority           String   @db.VarChar(30)
  source             String   @db.VarChar(30)
  sourceReportId     String?  @db.Uuid
  sourceInspectionId String?  @unique @db.Uuid
  sourceReference    String?  @db.VarChar(500)
  status             String   @default("OPEN") @db.VarChar(20)
  version            Int      @default(0)
  createdByUserId    String   @db.VarChar(255)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  estate       Estate       @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location     Location     @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset        Asset?       @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  sourceReport IssueReport? @relation(fields: [sourceReportId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  sourceInspection AssetInspectionResult? @relation(fields: [sourceInspectionId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  statusEvents      WorkOrderStatusEvent[]
  completion        WorkOrderCompletion?
  documents         Document[]
  documentLinksFrom DocumentWorkOrderEvent[] @relation("DocumentLinkFrom")
  documentLinksTo   DocumentWorkOrderEvent[] @relation("DocumentLinkTo")

  @@unique([id, estateId])
  @@unique([estateId, reference])
  @@index([estateId, createdAt, id])
  @@index([estateId, sourceReportId])
}

// Standalone, append-only asset inspection evidence. Follow-up is derived from the work-order link.
model AssetInspectionResult {
  id               String                 @id @default(uuid()) @db.Uuid
  estateId         String                 @db.Uuid
  assetId          String                 @db.Uuid
  locationId       String                 @db.Uuid
  locationPath     String                 @db.VarChar(650)
  outcome          String                 @db.VarChar(4)
  inspectedOn      DateTime               @db.Date
  notes            String?                @db.VarChar(2000)
  recordedByUserId String                 @db.VarChar(255)
  recordedByName   String?                @db.VarChar(255)
  createdAt        DateTime               @default(now()) @db.Timestamptz(6)
  estate           Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset            Asset                  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  location         Location               @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  photos           AssetInspectionPhoto[]
  workOrders       WorkOrder[]
  completedCheck   InspectionCheck?

  @@unique([id, estateId])
  @@index([estateId, assetId, inspectedOn, createdAt, id])
}

model AssetInspectionPhoto {
  id                 String                @id @default(uuid()) @db.Uuid
  estateId           String                @db.Uuid
  inspectionResultId String                @db.Uuid
  storageKey         String                @unique @db.VarChar(500)
  contentType        String                @db.VarChar(50)
  sizeBytes          Int
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  inspectionResult   AssetInspectionResult @relation(fields: [inspectionResultId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId, inspectionResultId])
}

// Append-only status audit. Version zero is the initial Open event for new orders.
model WorkOrderStatusEvent {
  id              String    @id @default(uuid()) @db.Uuid
  estateId        String    @db.Uuid
  workOrderId     String    @db.Uuid
  fromStatus      String?   @db.VarChar(20)
  toStatus        String    @db.VarChar(20)
  changedByUserId String    @db.VarChar(255)
  changedByName   String?   @db.VarChar(255)
  changedAt       DateTime  @default(now()) @db.Timestamptz(6)
  version         Int
  workOrder       WorkOrder @relation(fields: [workOrderId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workOrderId, version])
  @@index([estateId, workOrderId])
}

// Canonical outcome and costs; corrections retain identity and append revisions (decision 0035).
model WorkOrderCompletion {
  id                String                        @id @default(uuid()) @db.Uuid
  estateId          String                        @db.Uuid
  workOrderId       String                        @unique @db.Uuid
  findings          String                        @db.VarChar(2500)
  workPerformed     String                        @db.VarChar(2500)
  partsUsed         String?                       @db.VarChar(2500)
  labourCost        Decimal?                      @db.Decimal(14, 2)
  partsCost         Decimal?                      @db.Decimal(14, 2)
  currency          String                        @default("SGD") @db.VarChar(3)
  downtimeMinutes   Int?
  completedByUserId String                        @db.VarChar(255)
  completedByName   String?                       @db.VarChar(255)
  completedAt       DateTime                      @default(now()) @db.Timestamptz(6)
  editedByUserId    String?                       @db.VarChar(255)
  editedByName      String?                       @db.VarChar(255)
  editedAt          DateTime?                     @db.Timestamptz(6)
  revisions         WorkOrderCompletionRevision[]
  workOrder         WorkOrder                     @relation(fields: [workOrderId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workOrderId, estateId])
  @@index([estateId, completedAt, id])
}

// Append-only before/after audit for corrections to one canonical completion.
model WorkOrderCompletionRevision {
  id               String              @id @default(uuid()) @db.Uuid
  estateId         String              @db.Uuid
  workOrderId      String              @db.Uuid
  fromVersion      Int
  version          Int
  correctionReason String              @db.VarChar(500)
  changedByUserId  String              @db.VarChar(255)
  changedByName    String?             @db.VarChar(255)
  changedAt        DateTime            @default(now()) @db.Timestamptz(6)
  beforeOutcome    Json
  afterOutcome     Json
  completion       WorkOrderCompletion @relation(fields: [workOrderId, estateId], references: [workOrderId, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workOrderId, version])
  @@index([estateId, workOrderId])
}

// An asset category (decision 0026). `code` is stable and is what assets and
// catalogue models store. Rows are added only by migrations.
model AssetCategory {
  code      String                        @id @db.VarChar(30)
  label     String                        @db.VarChar(100)
  assets    Asset[]
  models    AssetModel[]
  flags     AssetCategoryFlagChange[]
  intervals AssetCategoryIntervalChange[]
}

// Append-only history of an estate's silent-failure flag per asset category (ID-83).
// The current flag is the latest row; with no rows, LIGHTING defaults to flagged.
model AssetCategoryFlagChange {
  id              String   @id @default(uuid()) @db.Uuid
  estateId        String   @db.Uuid
  category        String   @db.VarChar(30)
  failsSilently   Boolean
  changedByUserId String   @db.VarChar(255)
  changedByName   String?  @db.VarChar(255)
  changedAt       DateTime @default(now()) @db.Timestamptz(6)

  estate        Estate        @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetCategory AssetCategory @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId, category, changedAt])
}

// Append-only history of an estate's service interval per asset category (ID-81).
// The current interval is the latest row; a null value and unit clears it. No rows means no interval.
model AssetCategoryIntervalChange {
  id              String   @id @default(uuid()) @db.Uuid
  estateId        String   @db.Uuid
  category        String   @db.VarChar(30)
  intervalValue   Int?
  intervalUnit    String?  @db.VarChar(5)
  changedByUserId String   @db.VarChar(255)
  changedByName   String?  @db.VarChar(255)
  changedAt       DateTime @default(now()) @db.Timestamptz(6)

  estate        Estate        @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetCategory AssetCategory @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId, category, changedAt])
}

// Append-only history of one asset's service-interval override (ID-81).
// The current override is the latest row; a null value and unit removes it.
model AssetIntervalChange {
  id              String   @id @default(uuid()) @db.Uuid
  assetId         String   @db.Uuid
  intervalValue   Int?
  intervalUnit    String?  @db.VarChar(5)
  changedByUserId String   @db.VarChar(255)
  changedByName   String?  @db.VarChar(255)
  changedAt       DateTime @default(now()) @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([assetId, changedAt])
}

// A spot check due for one asset (ID-84). Open until an inspection result completes
// it; an open check from an earlier month is overdue (ID-86). One open check per asset.
model InspectionCheck {
  id                  String    @id @default(uuid()) @db.Uuid
  estateId            String    @db.Uuid
  assetId             String    @db.Uuid
  month               DateTime  @db.Date
  dueOn               DateTime  @db.Date
  dueBasis            String    @db.VarChar(15)
  intervalValue       Int?
  intervalUnit        String?   @db.VarChar(5)
  intervalSource      String?   @db.VarChar(8)
  generatedByUserId   String    @db.VarChar(255)
  generatedByName     String?   @db.VarChar(255)
  generatedAt         DateTime  @default(now()) @db.Timestamptz(6)
  completedByResultId String?   @unique @db.Uuid
  completedAt         DateTime? @db.Timestamptz(6)

  estate      Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset       Asset                  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  completedBy AssetInspectionResult? @relation(fields: [completedByResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assetId, month])
  @@index([estateId, month])
}

// Append-only record of each generation of an estate's monthly inspection list (ID-84),
// so a run that added nothing still counts as generated.
model InspectionListRun {
  id                String   @id @default(uuid()) @db.Uuid
  estateId          String   @db.Uuid
  month             DateTime @db.Date
  added             Int
  generatedByUserId String   @db.VarChar(255)
  generatedByName   String?  @db.VarChar(255)
  generatedAt       DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId, month, generatedAt])
}

// A manufacturer, shared by all estates (decision 0026). `name` is stored
// normalised: trimmed, inner whitespace collapsed, uppercased. Rows never change.
/// An in-app notification about one asset, visible to the estate's managers (spec notifications.md).
/// At most one open (unresolved) notification per asset and type; type-specific columns are checked in SQL.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  estateId   String    @db.Uuid
  assetId    String    @db.Uuid
  type       String    @db.VarChar(16)
  summary    String    @db.VarChar(300)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime? @db.Timestamptz(6)

  condition         String?   @db.VarChar(15)
  medianScore       Decimal?  @db.Decimal(5, 4)
  maxScore          Decimal?  @db.Decimal(5, 4)
  firstDetectedAt   DateTime? @db.Timestamptz(6)
  lastDetectedAt    DateTime? @db.Timestamptz(6)
  explanation       String?   @db.VarChar(500)
  response          String?   @db.VarChar(12)
  respondedByUserId String?   @db.VarChar(255)
  respondedByName   String?   @db.VarChar(255)
  respondedAt       DateTime? @db.Timestamptz(6)
  responseReason    String?   @db.VarChar(500)

  dueOn          DateTime? @db.Date
  intervalValue  Int?
  intervalUnit   String?   @db.VarChar(5)
  intervalSource String?   @db.VarChar(8)

  recommendedTimeframe String?  @db.VarChar(14)
  probability          Decimal? @db.Decimal(5, 4)
  basis                String?  @db.VarChar(17)
  failuresObserved     Int?

  estate Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset              @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  reads  NotificationRead[]

  @@index([estateId, createdAt(sort: Desc), id])
  @@index([assetId, type, createdAt])
}

/// One user's read receipt for a notification.
model NotificationRead {
  notificationId String   @db.Uuid
  userId         String   @db.VarChar(255)
  readAt         DateTime @default(now()) @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([notificationId, userId])
  @@index([userId])
}

/// Per-estate notification thresholds; an estate without a row uses the defaults.
model EstateNotificationSettings {
  estateId              String   @id @db.Uuid
  anomalyScoreThreshold Decimal  @db.Decimal(3, 2)
  serviceLeadDays       Int
  repairLeadDays        Int
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedByUserId       String   @db.VarChar(255)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

/// Marks that an estate's due notifications were swept for one Singapore day.
model NotificationSweep {
  estateId String   @db.Uuid
  day      DateTime @db.Date
  sweptAt  DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, day])
}

model Manufacturer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique @db.VarChar(200)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  models    AssetModel[]
  assets    Asset[]
  events    AssetEvent[]
}

// A model of one manufacturer in one asset category, shared by all estates
// (decision 0026). `name` is normalised like Manufacturer.name. The extra
// uniques are targets of the composite foreign keys on Asset and AssetEvent.
model AssetModel {
  id             String   @id @default(uuid()) @db.Uuid
  manufacturerId String   @db.Uuid
  category       String   @db.VarChar(30)
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)

  manufacturer  Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetCategory AssetCategory @relation(fields: [category], references: [code], onDelete: Restrict, onUpdate: Restrict)
  assets        Asset[]
  events        AssetEvent[]

  @@unique([manufacturerId, category, name])
  @@unique([id, manufacturerId])
  @@unique([id, manufacturerId, category])
}

// Something that happened to an asset on a date. Append-only like
// AssetAssessment: no updatedAt. `manufacturerId` and `modelId` snapshot the
// asset's catalogue entries when recorded (decision 0026).
model AssetEvent {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @db.Uuid
  assetId          String   @db.Uuid
  type             String   @db.VarChar(30)
  occurredOn       DateTime @db.Date
  notes            String   @db.VarChar(2000)
  manufacturerId   String?  @db.Uuid
  modelId          String?  @db.Uuid
  recordedByUserId String   @db.VarChar(255)
  recordedByName   String?  @db.VarChar(200)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  // Optional maintenance detail (ID-49); null means not known.
  findings         String?  @db.VarChar(2500)
  workPerformed    String?  @db.VarChar(2500)
  serviceProvider  String?  @db.VarChar(200)
  partsReplaced    String?  @db.VarChar(2500)
  downtimeMinutes  Int?
  // Optional SGD costs (ID-50); null means not known.
  labourCost       Decimal? @db.Decimal(14, 2)
  partsCost        Decimal? @db.Decimal(14, 2)
  otherCost        Decimal? @db.Decimal(14, 2)

  estate       Estate        @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset        Asset         @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  model        AssetModel?   @relation(fields: [modelId, manufacturerId], references: [id, manufacturerId], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId])
  @@index([assetId, occurredOn, createdAt])
}

// A sensor or meter registered against an asset (decision 0016). `identifier`
// is the label the manager enters, unique across all estates; it is not a
// credential. `metrics` holds names from the server's fixed catalogue. The
// composite foreign keys carry `estateId`, so Postgres rejects a device whose
// asset or location belongs to another estate.
model Device {
  id                       String    @id @default(uuid()) @db.Uuid
  estateId                 String    @db.Uuid
  assetId                  String    @db.Uuid
  locationId               String    @db.Uuid
  identifier               String    @unique @db.VarChar(100)
  model                    String    @db.VarChar(200)
  metrics                  String[]  @db.VarChar(30)
  reportingIntervalSeconds Int
  lastSeenAt               DateTime? @db.Timestamptz(6)
  // SHA-256 hex of the device's API key; the key itself is never stored (decision 0025).
  credentialHash           String?   @unique @db.Char(64)
  credentialIssuedAt       DateTime? @db.Timestamptz(6)
  // Permanent: a deactivated device keeps its readings but has no key (ID-45).
  deactivatedAt            DateTime? @db.Timestamptz(6)
  // The deactivated device this one replaced, on the same asset (ID-45).
  replacesDeviceId         String?   @db.Uuid
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  estate         Estate                @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset          Asset                 @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  location       Location              @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  readings       DeviceReading[]
  flatlinePauses DeviceFlatlinePause[]
  replaces       Device?               @relation("DeviceReplacement", fields: [replacesDeviceId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  replacedBy     Device?               @relation("DeviceReplacement")

  @@unique([id, estateId])
  // A device can be replaced only once.
  @@unique([replacesDeviceId, estateId])
  @@index([estateId])
  @@index([assetId])
  @@index([locationId])
}

// One measurement a device submitted (ID-43). Append-only: no updatedAt. A
// reading is identified by device, metric and `measuredAt` (decision 0028), so
// a retry cannot store it twice. `assetId` is the device's asset when the
// reading arrived. There is no unit column: the metric fixes it (decision 0016).
// The composite foreign keys carry `estateId`, so Postgres rejects a reading
// whose device or asset belongs to another estate.
model DeviceReading {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  estateId   String   @db.Uuid
  assetId    String   @db.Uuid
  metric     String   @db.VarChar(30)
  value      Decimal  @db.Decimal(18, 6)
  measuredAt DateTime @db.Timestamptz(6)
  receivedAt DateTime @db.Timestamptz(6)

  device Device @relation(fields: [deviceId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([deviceId, metric, measuredAt])
  @@index([assetId, metric, measuredAt])
}

// Human measurements remain separate from device ingestion and monitoring.
// Source is derived by the unified reading query, never chosen by the caller.
model ManualReading {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @db.Uuid
  assetId          String   @db.Uuid
  metric           String   @db.VarChar(30)
  value            Decimal  @db.Decimal(18, 6)
  measuredAt       DateTime @db.Timestamptz(6)
  recordedAt       DateTime @db.Timestamptz(6)
  recordedByUserId String
  recordedByName   String?  @db.VarChar(200)
  submissionId     String   @db.Uuid

  asset Asset @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([estateId, recordedByUserId, submissionId])
  @@index([assetId, metric, measuredAt])
}

// Shared detection settings for a metric within one estate (ID-68).
// No row means not configured; duration bounds and decimal validation live in the API.
model FlatlinePolicy {
  estateId        String   @db.Uuid
  metric          String   @db.VarChar(30)
  durationMinutes Int
  tolerance       Decimal  @default(0) @db.Decimal(18, 6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, metric])
}

// Retain the latest pause after expiry: resumesAt remains the fresh-start cutoff.
model DeviceFlatlinePause {
  deviceId       String   @db.Uuid
  metric         String   @db.VarChar(30)
  estateId       String   @db.Uuid
  assetId        String   @db.Uuid
  pausedAt       DateTime @db.Timestamptz(6)
  resumesAt      DateTime @db.Timestamptz(6)
  pausedByUserId String   @db.VarChar(255)

  device Device @relation(fields: [deviceId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@id([deviceId, metric])
  @@index([estateId])
}

// One condition assessment of an asset (decision 0017). Append-only: rows are
// never updated or deleted, so there is no updatedAt. The current condition is
// the latest `assessedOn`, then the latest `createdAt`. `recordedByName` is a
// WorkOS name snapshot taken when the row was written; null if WorkOS was
// unavailable. The composite foreign key keeps the estate consistent.
model AssetAssessment {
  id               String   @id @default(uuid()) @db.Uuid
  estateId         String   @db.Uuid
  assetId          String   @db.Uuid
  condition        String   @db.VarChar(30)
  assessedOn       DateTime @db.Date
  notes            String   @db.VarChar(2000)
  recordedByUserId String   @db.VarChar(255)
  recordedByName   String?  @db.VarChar(200)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  asset  Asset  @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@index([estateId])
  @@index([assetId, assessedOn, createdAt])
}

// Append-only model scores, one per reading sample.
model AnomalyScore {
  id         String   @id @default(uuid()) @db.Uuid
  estateId   String   @db.Uuid
  assetId    String   @db.Uuid
  measuredAt DateTime @db.Timestamptz(6)
  score      Float
  scoredAt   DateTime @db.Timestamptz(6)

  asset Asset @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assetId, measuredAt])
}

model AssetLifecycleEvent {
  id                       String    @id @default(uuid()) @db.Uuid
  estateId                 String    @db.Uuid
  assetId                  String    @db.Uuid
  action                   String    @db.VarChar(20)
  occurredAt               DateTime  @default(now()) @db.Timestamptz(6)
  actorUserId              String    @db.VarChar(255)
  previousDeactivatedAt    DateTime? @db.Timestamptz(6)
  previousRetiredOn        DateTime? @db.Date
  previousRetirementReason String?   @db.VarChar(2000)
  deactivatedAt            DateTime? @db.Timestamptz(6)
  retiredOn                DateTime? @db.Date
  retirementReason         String?   @db.VarChar(2000)
  lifecycleVersion         Int
  asset                    Asset     @relation(fields: [assetId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([assetId, lifecycleVersion])
  @@index([estateId, assetId])
}

// Estate-local Council invitations; WorkOS owns identity and email delivery.
model EstateInvitation {
  customRoleId         String?               @db.Uuid
  customRole           EstateRoleDefinition? @relation(fields: [customRoleId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)
  id                   String                @id @default(uuid()) @db.Uuid
  role                 String                @default("COUNCIL") @db.VarChar(20)
  estateId             String                @db.Uuid
  name                 String                @db.VarChar(200)
  email                String                @db.VarChar(254)
  inviterUserId        String                @db.VarChar(255)
  providerInvitationId String?               @unique @db.VarChar(255)
  status               String                @default("SENDING") @db.VarChar(20)
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  expiresAt            DateTime?             @db.Timestamptz(6)
  acceptedAt           DateTime?             @db.Timestamptz(6)
  acceptedUserId       String?               @db.VarChar(255)
  estate               Estate                @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([estateId, email])
  @@index([email, status])
}

// Application-defined catalogue. Codes and enforcement change together through migrations.
model Permission {
  code        String                 @id @db.VarChar(64)
  label       String                 @db.VarChar(120)
  description String                 @db.VarChar(500)
  roles       EstateRolePermission[]
}

model EstateRoleDefinition {
  id              String                 @id @default(uuid()) @db.Uuid
  estateId        String                 @db.Uuid
  name            String                 @db.VarChar(40)
  normalizedName  String                 @db.VarChar(40)
  description     String?                @db.VarChar(500)
  createdByUserId String                 @db.VarChar(255)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  version         Int                    @default(1)
  estate          Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions     EstateRolePermission[]
  members         EstateUser[]
  invitations     EstateInvitation[]

  @@unique([id, estateId])
  @@unique([estateId, normalizedName])
}

model EstateRolePermission {
  roleId     String               @db.Uuid
  permission String               @db.VarChar(64)
  role       EstateRoleDefinition @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  catalogue  Permission           @relation(fields: [permission], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permission])
}

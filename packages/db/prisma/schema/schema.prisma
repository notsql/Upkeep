generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Estate {
  id            String         @id @default(uuid()) @db.Uuid
  ownerUserId   String         @db.VarChar(255)
  name          String         @db.VarChar(200)
  code          String         @unique @db.VarChar(50)
  address       String         @db.VarChar(500)
  postalCode    String         @db.VarChar(20)
  description   String?        @db.VarChar(2000)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime?      @db.Timestamptz(6)
  locations     Location[]
  users         EstateUser[]
  assets        Asset[]

  @@index([ownerUserId])
}

// A block, level or common area inside an estate. Levels sit under blocks;
// common areas sit under a block or a level. `parentType` repeats the parent's
// type, and the composite foreign key also carries `estateId`, so Postgres
// rejects a parent of the wrong type or from another estate. The type rules
// themselves live in the hand-written Location_hierarchy_check constraint in
// the migration (Prisma cannot express CHECK constraints). Rows are never
// deleted: deactivation keeps the ID stable for records that reference it.
model Location {
  id            String    @id @default(uuid()) @db.Uuid
  estateId      String    @db.Uuid
  type          String    @db.VarChar(20)
  parentId      String?   @db.Uuid
  parentType    String?   @db.VarChar(20)
  name          String    @db.VarChar(200)
  sortOrder     Int?
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  estate   Estate     @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parent   Location?  @relation("LocationTree", fields: [parentId, parentType, estateId], references: [id, type, estateId], onDelete: Restrict, onUpdate: Restrict)
  children Location[] @relation("LocationTree")
  assets   Asset[]

  @@unique([id, type, estateId])
  @@unique([id, estateId])
  @@index([estateId])
  @@index([parentId])
}

// A WorkOS user an admin has assigned to an estate, giving them view access.
// Ownership stays on Estate.ownerUserId; see decision 0012.
model EstateUser {
  estateId  String   @db.Uuid
  userId    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([estateId, userId])
  @@index([userId])
}

// A piece of equipment in an estate. `reference` is assigned by the server as
// `<ESTATE CODE>-A<nnnn>` (decision 0015). The composite foreign key to Location
// carries `estateId`, so Postgres rejects a location from another estate. Rows
// are never deleted: deactivation sets `deactivatedAt`.
model Asset {
  id            String    @id @default(uuid()) @db.Uuid
  estateId      String    @db.Uuid
  locationId    String    @db.Uuid
  reference     String    @db.VarChar(60)
  name          String    @db.VarChar(200)
  category      String    @db.VarChar(30)
  installedOn   DateTime? @db.Date
  manufacturer  String?   @db.VarChar(200)
  model         String?   @db.VarChar(200)
  serialNumber  String?   @db.VarChar(200)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  deactivatedAt DateTime? @db.Timestamptz(6)

  estate   Estate   @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  location Location @relation(fields: [locationId, estateId], references: [id, estateId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([estateId, reference])
  @@index([estateId])
  @@index([locationId])
}

# Spring Boot reads these; see apps/server/src/main/resources/application.yaml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/proj
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SERVER_PORT=8080

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3001

# Copy the exact iss claim from a WorkOS access token and the API audience.
# Uppercase keys work in both the process environment and this .env file.
# The audience must exactly match the `aud` value in your WorkOS JWT template.
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://api.workos.com/user_management/client_your_client_id
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=https://your-api.example.com

# WorkOS API key (sk_...). Server-side secret, needed for GET /users.
# Blank is safe: /users then returns 503.
WORKOS_API_KEY=

# Accesses WorkOS's API, this url is associated with your Staging environment.
WORKOS_API_BASE_URL=https://api.workos.com

# Where Spring reaches apps/ml. Not read yet; docker-compose sets http://ml:8000.
ML_API_URL=http://localhost:8000

# Required only if you use the Spring AI Anthropic integration.
ANTHROPIC_API_KEY=

# Private resident report images (Cloudflare R2, S3-compatible API)
S3_ENDPOINT=
R2_ACCESS_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

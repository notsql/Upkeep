{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "server",
  "projectType": "application",
  "metadata": {
    "mavenProject": "com.proj:server"
  },
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["package"],
      "metadata": {
        "description": "Alias for the Maven `package` phase so `nx run-many -t build` covers Java too."
      }
    },
    "dev": {
      "executor": "@nx/maven:maven",
      "options": { "goals": "spring-boot:run" },
      "metadata": {
        "description": "Runs the API with devtools reload on :8080."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -pl com.proj:server spotless:check",
        "cwd": "{workspaceRoot}"
      },
      "metadata": {
        "description": "Checks Java formatting with Spotless."
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -pl com.proj:server spotless:apply",
        "cwd": "{workspaceRoot}"
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -pl com.proj:server verify -Popenapi -DskipTests",
        "cwd": "{workspaceRoot}"
      },
      "metadata": {
        "description": "Exports the OpenAPI contract to packages/api/openapi.json. Runs ./mvnw directly: the @nx/maven batch executor drops -P profile args."
      }
    },
    "db:generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw -pl com.proj:server generate-sources -Pjooq",
        "cwd": "{workspaceRoot}"
      },
      "metadata": {
        "description": "Regenerates the jOOQ classes in com.proj.server.db from the migrated database. Reads the database in apps/server/.env. Runs ./mvnw directly for the same reason as openapi."
      }
    }
  }
}

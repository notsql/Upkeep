# Base URL of the Spring Boot API (browser calls it directly).
VITE_API_URL=http://localhost:8080
# Server-only AuthKit configuration. Never prefix these secrets with VITE_.
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=sk_test_your_api_key
WORKOS_REDIRECT_URI=http://localhost:3001/api/auth/callback
# Generate a random value of at least 32 characters. Never commit the real value.
WORKOS_COOKIE_PASSWORD=replace_with_a_random_32_character_secret
# Must match the inactivity policy configured in the WorkOS Sessions dashboard.
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30

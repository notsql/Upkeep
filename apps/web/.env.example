# Base URL of the Spring Boot API (browser calls it directly).
VITE_API_URL=http://localhost:8080
# Public client ID from the WorkOS dashboard. This is not an API secret.
VITE_WORKOS_CLIENT_ID=client_your_client_id
# Must exactly match a redirect URI registered in the WorkOS dashboard.
VITE_WORKOS_REDIRECT_URI=http://localhost:3001

{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{workspaceRoot}/apps/web/dist/**",
      "!{workspaceRoot}/apps/web/.vinxi/**",
      "!{workspaceRoot}/apps/web/.tanstack/**",
      "!{workspaceRoot}/apps/web/src/routeTree.gen.ts",
      "!{workspaceRoot}/packages/db/dist/**",
      "!{workspaceRoot}/packages/db/prisma/generated/**",
      "!{workspaceRoot}/apps/web/tests/**",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "inputs": ["default", "^default"]
    },
    "test": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "test:watch": {
      "cache": false,
      "continuous": true
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "db:push": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "continuous": true
    },
    "db:start": {
      "cache": false
    },
    "db:stop": {
      "cache": false
    },
    "db:watch": {
      "cache": false,
      "continuous": true
    },
    "db:down": {
      "cache": false
    },
    "openapi": {
      "cache": false
    }
  },
  "plugins": ["@nx/maven"],
  "analytics": false
}
